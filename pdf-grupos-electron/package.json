{
  "name": "pdf-grupos-desktop",
  "version": "1.0.0",
  "type": "module",
  "description": "Agrupador local de PDFs para Windows",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "start": "electron .",
    "dist": "npm run build:web && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.3.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "0.487.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "br.com.pdfgrupos.desktop",
    "productName": "PDF Grupos",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
